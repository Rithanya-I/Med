<script>
  (function initMediBotInteractions() {
    const bookBtn = document.getElementById('book-slot-btn');
    const confirmBanner = document.getElementById('booking-confirmation-banner');
    const chatForm = document.getElementById('chat-input-form');
    const inputField = document.getElementById('user-input-field');
    const chatStream = document.getElementById('chat-stream');
    const micBtn = document.getElementById('mic-btn');
    const quickChips = document.querySelectorAll('.quick-chip');
    const resetBtn = document.getElementById('restart-chat-btn');

    if (bookBtn && confirmBanner) {
      bookBtn.addEventListener('click', () => {
        bookBtn.disabled = true;
        bookBtn.classList.add('opacity-75');
        bookBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Reserving with clinic...</span>';
        
        setTimeout(() => {
          bookBtn.classList.remove('opacity-75');
          bookBtn.classList.replace('bg-primary', 'bg-surface-container-high');
          bookBtn.classList.replace('text-on-primary', 'text-on-surface-variant');
          bookBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Reserved for Priya</span>';
          confirmBanner.classList.remove('hidden');
          confirmBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 800);
      });
    }

    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        if (inputField) {
          inputField.value = chip.querySelector('span:last-child')?.textContent || '';
          inputField.focus();
        }
      });
    });

    if (chatForm && inputField) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = inputField.value.trim();
        if (!query) return;

        // Append user bubble
        const userBubble = document.createElement('div');
        userBubble.className = 'flex items-end justify-end gap-2 self-end max-w-[88%] ml-auto';
        userBubble.innerHTML = `
          <div class="flex flex-col items-end space-y-1">
            <div class="bg-primary text-on-primary rounded-2xl rounded-tr-sm px-4 py-3 shadow-sm">
              <p class="font-body-sm text-body-sm leading-relaxed text-on-primary">\${escapeHtml(query)}</p>
            </div>
            <div class="flex items-center gap-1 pr-1">
              <span class="font-label-sm text-label-sm text-on-surface-variant">Just now</span>
              <span class="material-symbols-outlined text-[14px] text-primary">done</span>
            </div>
          </div>
          <div class="w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0 mb-4 shadow-sm">
            <span class="material-symbols-outlined text-[16px]">person</span>
          </div>
        `;
        chatStream.appendChild(userBubble);
        inputField.value = '';
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });

        // Simulated AI response
        setTimeout(() => {
          const aiResponse = document.createElement('div');
          aiResponse.className = 'flex items-start gap-2.5 max-w-[94%]';
          aiResponse.innerHTML = `
            <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container shrink-0 shadow-sm mt-0.5">
              <span class="material-symbols-outlined text-[18px]">smart_toy</span>
            </div>
            <div class="bg-surface-container-lowest rounded-2xl rounded-tl-sm p-4 shadow-sm text-on-surface">
              <p class="font-body-sm text-body-sm leading-relaxed">
                Analyzing clinic schedules matching "<span class="font-medium text-primary">\${escapeHtml(query)}</span>". Filter applied: Next available 5-star clinic slots with direct insurance sync.
              </p>
            </div>
          `;
          chatStream.appendChild(aiResponse);
          window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }, 600);
      });
    }

    if (micBtn) {
      micBtn.addEventListener('click', () => {
        micBtn.classList.toggle('text-error');
        if (inputField) {
          inputField.setAttribute('placeholder', micBtn.classList.contains('text-error') ? 'Listening to symptom or doctor request...' : 'Tell MediBot what specialist or slot you need...');
        }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        location.reload();
      });
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  })();
