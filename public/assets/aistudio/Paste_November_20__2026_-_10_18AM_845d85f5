  (function initDoctorProfile() {
    let selectedSlot = '2:30 PM';
    let isFavorited = false;
    let bioExpanded = false;

    const favBtn = document.getElementById('favBtn');
    const favIcon = document.getElementById('favIcon');
    const shareBtn = document.getElementById('shareBtn');
    const slotButtons = document.querySelectorAll('.slot-btn');
    const bottomSlotIndicator = document.getElementById('bottomSlotIndicator');
    const toggleBioBtn = document.getElementById('toggleBioBtn');
    const bioText = document.getElementById('bioText');
    const bioToggleIcon = document.getElementById('bioToggleIcon');
    const confirmBookingBtn = document.getElementById('confirmBookingBtn');
    const customDateBtn = document.getElementById('customDateBtn');

    // Toggle Favorite Heart
    if (favBtn && favIcon) {
      favBtn.addEventListener('click', () => {
        isFavorited = !isFavorited;
        if (isFavorited) {
          favIcon.style.fontVariationSettings = "'FILL' 1";
          favIcon.classList.remove('text-secondary');
          favIcon.classList.add('text-error');
          favBtn.classList.add('bg-error-container');
        } else {
          favIcon.style.fontVariationSettings = "'FILL' 0";
          favIcon.classList.remove('text-error');
          favIcon.classList.add('text-secondary');
          favBtn.classList.remove('bg-error-container');
        }
      });
    }

    // Native Web Share or Toast fallback
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'Dr. Aisha Ray, MD, FAAD',
              text: 'Book an appointment with Dr. Aisha Ray, MD on our healthcare clinic platform.',
              url: window.location.href,
            });
          } catch (e) {
            // Cancelled or unsupported
          }
        } else {
          alert('Profile link copied to clipboard!');
        }
      });
    }

    // Time Slot Selection Handling
    slotButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        slotButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary');
          b.classList.add('bg-surface-container-low', 'text-on-surface');
        });
        btn.classList.remove('bg-surface-container-low', 'text-on-surface');
        btn.classList.add('bg-primary', 'text-on-primary');
        
        selectedSlot = btn.getAttribute('data-slot');
        if (bottomSlotIndicator) {
          bottomSlotIndicator.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span> Selected slot: Today ' + selectedSlot;
        }
      });
    });

    // Biography expand / collapse
    if (toggleBioBtn && bioText && bioToggleIcon) {
      toggleBioBtn.addEventListener('click', () => {
        bioExpanded = !bioExpanded;
        if (bioExpanded) {
          bioText.classList.remove('line-clamp-3');
          toggleBioBtn.querySelector('span:first-child').textContent = 'Read Less';
          bioToggleIcon.textContent = 'expand_less';
        } else {
          bioText.classList.add('line-clamp-3');
          toggleBioBtn.querySelector('span:first-child').textContent = 'Read More';
          bioToggleIcon.textContent = 'expand_more';
        }
      });
    }

    // CTA Click triggers custom date & time flow
    if (confirmBookingBtn) {
      confirmBookingBtn.addEventListener('click', () => {
        confirmBookingBtn.innerHTML = '<span>Opening Schedule...</span>';
        setTimeout(() => {
          confirmBookingBtn.innerHTML = '<span>Select Date & Time</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span>';
        }, 1200);
      });
    }

    if (customDateBtn) {
      customDateBtn.addEventListener('click', () => {
        if (confirmBookingBtn) confirmBookingBtn.click();
      });
    }
  })();
</script></main></body></html>

