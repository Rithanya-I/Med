      'login': document.getElementById('tab-btn-login')
    };

    Object.keys(panels).forEach(key => {
      if (key === target) {
        panels[key].classList.remove('hidden');
        panels[key].classList.add('flex');
        buttons[key].className = 'flex-1 py-2 rounded-full text-center transition-all duration-300 bg-surface-container-lowest text-primary shadow-sm font-label-md text-label-md flex items-center justify-center gap-1';
      } else {
        panels[key].classList.add('hidden');
        panels[key].classList.remove('flex');
        buttons[key].className = 'flex-1 py-2 rounded-full text-center transition-all duration-300 text-on-surface-variant hover:text-on-surface font-label-md text-label-md flex items-center justify-center gap-1';
      }
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

