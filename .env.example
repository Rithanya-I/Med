# ==========================================================
# MediSlot AI - Environment Configuration
# ==========================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (doctor triage & MediBot concierge).
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==========================================================
# Supabase Configuration
# ==========================================================
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API & Database:
# https://supabase.com/dashboard/project/<your-project-ref>/settings/api

# 1. Supabase Project REST / Auth API URL
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase Anon Public Key (used by frontend & safe for public clients)
SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 3. Supabase Service Role Key (Backend only - bypasses RLS for administrative access)
# DO NOT expose this key in frontend code or Git!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 4. PostgreSQL Database Connection URL
# Recommended: Connection Pooler (Transaction mode, port 6543) or Direct connection (port 5432)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Optional: Granular PostgreSQL parameters (if not using DATABASE_URL)
# SQL_HOST="db.your-project-ref.supabase.co"
# SQL_PORT=5432
# SQL_USER="postgres"
# SQL_PASSWORD="your-db-password"
# SQL_DB_NAME="postgres"
# SQL_SSL="true"
